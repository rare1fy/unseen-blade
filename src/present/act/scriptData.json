  {
   "who": "duwu",
   "text": "麦饼刚烘的，揣怀里，出刀时肚里不慌。"
  },
  {
   "who": "duwu",
   "text": "白哥年纪比俺还小，头发咋就全白了？"
  },
  {
   "who": "duwu",
   "text": "俺攒了几个铜钱，等你砍完人，咱打壶酒。"
  },
  {
   "who": "duwu",
   "text": "早去早回，俺在窑口等你。"
  }
 ],
 "npc_sunao": [
  {
   "who": "sunao",
   "text": "裹胸勒太紧，出刀换不上气。这窑里没人看。"
  },
  {
   "who": "sunao",
   "text": "老身这只眼，是在宫里哭瞎的。你呢？"
  },
  {
   "who": "sunao",
   "text": "杜五那傻小子，还当你是条好汉。"
  },
  {
   "who": "sunao",
   "text": "嘴上说不喝外人的东西，倒记着杜五拿鞋换来的诊金。"
  },
  {
   "who": "sunao",
   "text": "过来烤烤手。人是肉长的，刀可冻不坏。"
  },
  {
   "who": "sunao",
   "text": "外头尸山血海，瞎着眼，倒少看点脏东西。"
  },
  {
   "who": "sunao",
   "text": "药在炭上煨着。苦，喝了能多熬半宿。"
  },
  {
   "who": "sunao",
   "text": "去吧。灶上留了热水，回来洗洗身上的血。"
  }
 ],
 "stele_none": [
  {
   "who": "jiangjin",
   "text": "那人我喂了三天热汤。那夜，是他开的坞门。"
  },
  {
   "who": "jiangjin",
   "text": "文皎死在那夜了。往后，只有刘白。"
  },
  {
   "who": "jiangjin",
   "text": "抱着阿爹坐了一宿，落了一头雪，七年没化。"
  },
  {
   "who": "jiangjin",
   "text": "石雷，阎虎，封寒，周默，崔玄。……手不能抖。"
  }
 ],
 "stele_one": [
  {
   "who": "jiangjin",
   "text": "第一道槽，摸着真冷。"
  },
  {
   "who": "jiangjin",
   "text": "还有四个。"
  },
  {
   "who": "jiangjin",
   "text": "杀了他，风雪也没停。"
  },
  {
   "who": "jiangjin",
   "text": "阎虎……在洛阳。"
  }
 ],
 "stele_two": [
  {
   "who": "jiangjin",
   "text": "第二道槽。"
  },
  {
   "who": "jiangjin",
   "text": "他说娘是从崔府逃出来的乐伎……我不信。"
  },
  {
   "who": "jiangjin",
   "text": "还有封寒，周默，崔玄。"
  },
  {
   "who": "jiangjin",
   "text": "封寒在下邳。"
  }
 ],
 "stele_three": [
  {
   "who": "jiangjin",
   "text": "第三把刀收回来了。阿爹的手指也回来了。"
  },
  {
   "who": "jiangjin",
   "text": "替崔府灭口……究竟谁在算计谁？"
  },
  {
   "who": "jiangjin",
   "text": "周默在乌林。"
  },
  {
   "who": "jiangjin",
   "text": "那条我救活的狗，该还债了。"
  }
 ],
 "stele_four": [
  {
   "who": "jiangjin",
   "text": "四个名字都划了。"
  },
  {
   "who": "jiangjin",
   "text": "只剩最底下这一个。"
  },
  {
   "who": "jiangjin",
   "text": "崔玄……你造的孽，自己来还。"
  },
  {
   "who": "jiangjin",
   "text": "剩下的刀，都在许都。"
  }
 ],
 "stele_strike_1": [
  {
   "who": "jiangjin",
   "text": "石雷，销了。阿爹，第一把。"
  }
 ],
 "stele_strike_2": [
  {
   "who": "jiangjin",
   "text": "阎虎，销了。阿爹，第二把。"
  }
 ],
 "stele_strike_3": [
  {
   "who": "jiangjin",
   "text": "封寒，销了。阿爹，第三把。"
  }
 ],
 "stele_strike_4": [
  {
   "who": "jiangjin",
   "text": "周默，销了。阿爹，第四把。"
  }
 ],
 "meal_offer": [
  {
   "who": "duwu",
   "text": "白哥，挑一样揣上再走。"
  },
  {
   "who": "duwu",
   "text": "外头死人比活人多，俺别的不会，管饱。"
  },
  {
   "who": "duwu",
   "text": "空着肚子咋拼刀子？挑一样，驴车套好了。"
  }
 ],
 "meal_packed": [
  {
   "who": "duwu",
   "text": "东西都揣好了，快去快回！"
  },
  {
   "who": "duwu",
   "text": "家底就这点了，别看俺，赶紧走吧。"
  }
 ],
 "meal_feast": [
  {
   "who": "duwu",
   "text": "俺拿三根指头揉的面，瓷实，吃饱了抗揍！"
  }
 ],
 "meal_purse": [
  {
   "who": "duwu",
   "text": "收尸攒的铜钱，路上好打点。"
  }
 ],
 "meal_wine": [
  {
   "who": "duwu",
   "text": "这酒呛嗓子，闷一口，挨刀都不觉疼！"
  }
 ],
 "up_sunao": [
  {
   "who": "sunao",
   "text": "忍着点，扎偏一寸可不怪我。"
  },
  {
   "who": "sunao",
   "text": "坐稳了。这几针下去，鬼门关前也能抢回条命。"
  }
 ],
 "poor_sunao": [
  {
   "who": "sunao",
   "text": "药引不够，老身总不能拿白水给你熬命。"
  }
 ],
 "pro_ambush": [
